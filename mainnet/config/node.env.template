# Vordium node environment — TEMPLATE. Paths only; NEVER secrets.
# Copy to node.env. Do not put keys, tokens, or seeds here — key material lives in
# secrets/ (0600) and is referenced by node.toml.
VORDIUM_CONFIG=config/node.toml
# Required on every validator of this network; leave as shipped.
VORDIUM_AA1981_STRICT_GENESIS_T0=1
