[Unit]
Description=Vordium test network validator
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/vordium
Environment=VORDIUM_CONFIG=/opt/vordium/config/node.toml
Environment=VORDIUM_BFT=1
Environment=VORDIUM_AA1981_STRICT_GENESIS_T0=1
EnvironmentFile=/opt/vordium/config/node.env
ExecStart=/opt/vordium/bin/vordiumchain
Restart=always
RestartSec=2
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
