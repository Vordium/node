# Vordium test network (chain id 101102) — node config template.
# No keys and no addresses. Paths are relative to the install directory.
# [network] peers and validator_endpoints are sent to you when your application is accepted.
schema_version = 1
role = "validator"

[paths]
data_dir = "data/chain"
genesis = "config/genesis.json"
candles_dir = "data/candles"

[keys]
validator_key_file = "secrets/validator.key"
vrf_key_file = "secrets/vrf-seed"

[network]
p2p_listen = "0.0.0.0:9000"
peers = []                 # provided on acceptance
validator_endpoints = []   # provided on acceptance, same order as [validators].set

[validators]
set = ["0x05E67609fA7f7830509c2b508E96c6ADe6d0D1bE", "0x1e581109AD004c6124800f0d10dda646F480Bf11", "0x5E433f9eF606ee4fecee6d482D0ADFd158e7598b", "0x71B859E2355Fff85e4b7192FE8947762d1Af93C3", "0x891D3c72D64E1E05bdF4A69c3416306E24738C3B", "0xa078Eb334a798aB90F565d63Bd82DCD220246147", "0xD8538057dfDf9BDA424Ae1A9f03F2706Bd0311d0"]

[rpc]
session_port = 9001
trading_port = 9002
ws_port = 9003
evm_rpc_port = 9100

