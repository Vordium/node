keep_blocks = 400000
compact_on_boot = false

[logging]
level = "info"

# The test vault lives on Arbitrum Sepolia. Two public providers from different companies;
# put their URLs in the environment under these names (see node.env.template).
[bridge_v4]
finality_depth = 20
pass_interval_s = 10
providers = [
  { chain_id = 421614, company = "provider-a", url_env = "TN_ARB_SEPOLIA_A", max_block_range = 2000 },
  { chain_id = 421614, company = "provider-b", url_env = "TN_ARB_SEPOLIA_B", max_block_range = 2000 },
]
